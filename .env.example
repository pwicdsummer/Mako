# ============================================================
# MakoTalker 环境变量配置模板
# ============================================================
# 使用方法：
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 填入你的真实 API Key / 配置
#   3. .env 已被 .gitignore 排除，不会被提交到 Git
#
# 注意：所有变量均为可选，未设置时将使用本地兜底方案。
# ============================================================

# ---- Fish Audio 云端 TTS ----
# 在 https://fish.audio 注册并获取 API Key
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# 参考音频 ID（在 Fish Audio 后台创建声音克隆后获得）
FISH_AUDIO_REFERENCE_ID=your_reference_id_here

# ---- Letta / MemGPT 服务 ----
# Letta Agent Server 地址（默认本地 8283 端口）
LETTA_BASE_URL=http://127.0.0.1:8283

# ---- GPT-SoVITS 本地 TTS 服务 ----
# GPT-SoVITS 推理服务地址（默认本地 9880 端口）
GPT_SOVITS_URL=http://127.0.0.1:9880
